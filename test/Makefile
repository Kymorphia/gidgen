# gidgen integration tests
#
# Test libraries are bound by gidgen and exercised with D unittests in gidgen-test/:
#   GidgenFeat - Hand written annotated C library in gidgen-feat/ with its GIR generated by g-ir-scanner, and hand
#                written D unittests in gidgen-test/feat_*.d (feature tests)
#   GidgenMatrix - Generated type/position matrix test library. matrix-gen/ crosses a type table with a position
#                table and generates C functions (gidgen-matrix/gidgen-matrix-gen.c/.h, built together with the hand
#                written gidgen-matrix/gidgen-matrix-support.c/.h) and a D manifest (gidgen-test/matrix_manifest.d)
#                which drives the generic D unittest gidgen-test/matrix_test.d, as well as the gidgen definitions
#                file test-defs/gidgenmatrix1.d
#   GidgenExport - D shared library in export-test/ exporting GObjectExport subclasses of GidgenFeat types, used by
#                the C program export-test/export_test.c without a D main() (D runtime initialization, C threads,
#                C created instances and their lifetime), built linked against the library and using dlopen
#   GidgenMixer - D shared library in export-mixer/ using the GidgenExport types from another namespace
#   Round trip - gidgen generates D bindings from the GIRs which GidgenExport and GidgenMixer write, used by the D
#                program roundtrip/client like the bindings of any C library
#
# GLib critical warnings are made fatal (G_DEBUG=fatal-criticals) so that they fail the tests.
#
# Targets:
#   run-test          Build and run the unittests, the GObjectExport C program test, and the external dependency repository test (ext-test)
#   run-test-export   Build and run the GObjectExport C program test only
#   run-test-gir      Write the GIRs of the GObjectExport test libraries, compile them to typelibs and use the libraries
#                     from Python (needs g-ir-compiler and PyGObject)
#   run-test-roundtrip Generate D bindings from the GIRs of the GObjectExport test libraries and use the libraries
#                     through them from a D program
#   unit-test         Run the gidgen source unittests
#   ext-test          Test generating a child repository which depends on another repository (ext-child/)
#   run-test-valgrind Run the unittests under valgrind memcheck (memory errors and definite leaks)
#   run-test-asan     Run the unittests with the C test libraries built with AddressSanitizer (memory errors)
#   coverage          Build gidgen with coverage instrumentation, run it on the test GIRs and print a per source file
#                     coverage summary (.lst files are written to coverage/)
#   clean             Remove generated files

DUB ?= dub
DC ?= ldc2
GIDGEN_DEFS = ../../defs
RUNTIME_DEF_FILES = $(notdir $(wildcard $(GIDGEN_DEFS)/gid*.d $(GIDGEN_DEFS)/glib2*.d $(GIDGEN_DEFS)/gobject2*.d \
  $(GIDGEN_DEFS)/gmodule2*.d))

TEST_CFLAGS = -g -Wall $(shell pkg-config --cflags gobject-2.0) $(EXTRA_CFLAGS)
TEST_LDFLAGS = $(shell pkg-config --libs gobject-2.0) $(EXTRA_LDFLAGS)

TEST_BIN = gidgen-test/gidgen-test
FEAT_LIB = gidgen-test/libgidgen-feat.so.0
MATRIX_LIB = gidgen-test/libgidgen-matrix.so.0
SHIM_LIBS = gidgen-test/libshimlib-1.so.0 gidgen-test/libshimlib-2.so.0
LIBS = $(FEAT_LIB) $(MATRIX_LIB) $(SHIM_LIBS)
GIRS = gir/GidgenFeat-1.0.gir gir/GidgenMatrix-1.0.gir

MATRIX_GEN = matrix-gen/matrix-gen
MATRIX_GEN_C = gidgen-matrix/gidgen-matrix-gen.c gidgen-matrix/gidgen-matrix-gen.h
MATRIX_MANIFEST = gidgen-test/matrix_manifest.d
MATRIX_DEFS = test-defs/gidgenmatrix1.d
MATRIX_SRC = gidgen-matrix/gidgen-matrix-support.c gidgen-matrix/gidgen-matrix-gen.c
MATRIX_HDR = gidgen-matrix/gidgen-matrix-support.h gidgen-matrix/gidgen-matrix-gen.h

GIDGEN_SOURCES = $(wildcard ../source/*.d ../source/*/*.d)
COV_BIN = coverage/gidgen-cov
GLIB_SUPP = $(shell pkg-config --variable=prefix glib-2.0)/share/glib-2.0/valgrind/glib.supp

.PHONY: run-test
run-test: unit-test build-test ext-test
	cd gidgen-test && LD_LIBRARY_PATH="$$(pwd)" G_DEBUG=fatal-criticals ./$(notdir $(TEST_BIN))
	$(MAKE) run-test-export
	$(MAKE) run-test-gir
	$(MAKE) run-test-roundtrip
	cd gidgen-test && $(DUB) build -q --compiler=$(DC) --config=loader-override
	cd gidgen-test && LD_LIBRARY_PATH="$$(pwd)" G_DEBUG=fatal-criticals \
	  GID_RTLD_LOCAL=gid.gidgenfeat1 GID_RTLD_GLOBAL=gid.shimlib1,gid.shimlib2 ./gidgen-loader-override

.PHONY: unit-test
unit-test:
	cd .. && $(DUB) test -q --compiler=$(DC)

EXPORT_CFLAGS = $(TEST_CFLAGS) -Igidgen-feat
EXPORT_LDFLAGS = -Lgidgen-test -lgidgen-feat -lpthread $(TEST_LDFLAGS)

GIR_TEST_ENV = GI_TYPELIB_PATH="$$(pwd)/typelib" LD_LIBRARY_PATH="$$(pwd):$$(pwd)/../export-mixer:$$(pwd)/../gidgen-test" \
  G_DEBUG=fatal-criticals

# export-mixer (GidgenMixer) uses the types of export-test (GidgenExport) from another namespace.
# The GIR of GidgenFeat is copied without nested records, which g-ir-compiler 1.84 can't parse
.PHONY: export-gir
export-gir: packages/README.md $(FEAT_LIB)
	cd export-test && $(DUB) build -q --compiler=$(DC) && $(DUB) build -q --compiler=$(DC) --config=gir
	cd export-mixer && $(DUB) build -q --compiler=$(DC) && $(DUB) build -q --compiler=$(DC) --config=gir
	cd export-test && LD_LIBRARY_PATH="$$(pwd)/../gidgen-test" G_DEBUG=fatal-criticals ./gidgen-export-gir
	cd export-mixer && LD_LIBRARY_PATH="$$(pwd)/../export-test:$$(pwd)/../gidgen-test" G_DEBUG=fatal-criticals \
	  ./gidgen-mixer-gir --gir ../export-test/GidgenMixer-1.0.gir

.PHONY: run-test-gir
run-test-gir: export-gir gir/GidgenFeat-1.0.gir
	mkdir -p export-test/typelib
	python3 export-test/strip_nested.py gir/GidgenFeat-1.0.gir export-test/typelib/GidgenFeat-1.0.gir
	cd export-test && g-ir-compiler --includedir=typelib typelib/GidgenFeat-1.0.gir -o typelib/GidgenFeat-1.0.typelib
	cd export-test && g-ir-compiler --includedir=typelib GidgenExport-1.0.gir -o typelib/GidgenExport-1.0.typelib
	cd export-test && g-ir-compiler --includedir=typelib --includedir=. GidgenMixer-1.0.gir \
	  -o typelib/GidgenMixer-1.0.typelib
	cd export-test && GI_TYPELIB_PATH=typelib g-ir-inspect --print-shlibs --print-typelibs --version=1.0 GidgenMixer \
	  > typelib/inspect-mixer.txt && grep -qx 'shlib: libgidgen-mixer.so' typelib/inspect-mixer.txt \
	  && grep -qx 'typelib: GidgenExport-1.0' typelib/inspect-mixer.txt
	cd export-test && GI_TYPELIB_PATH=typelib g-ir-inspect --print-shlibs --print-typelibs --version=1.0 GidgenExport \
	  > typelib/inspect.txt && grep -qx 'shlib: libgidgen-export.so' typelib/inspect.txt \
	  && grep -qx 'typelib: GidgenFeat-1.0' typelib/inspect.txt
	cd export-test && g-ir-generate --includedir=typelib typelib/GidgenExport-1.0.typelib > typelib/roundtrip.gir \
	  && grep -q 'c:identifier="gidgen_export_virt_stats"' typelib/roundtrip.gir \
	  && grep -q '<virtual-method name="scale" .*invoker="scale"' typelib/roundtrip.gir
	cd export-test && $(GIR_TEST_ENV) timeout 120 python3 gi_test.py

# GIR export round trip: gidgen generates the binding packages of GidgenExport and GidgenMixer from their GIRs into
# roundtrip/out (a repository depending on the test repository, like ext-test), and the D program roundtrip/client uses
# the libraries through them: constructors, methods, functions, out values, GError, properties, signals, D subclasses
# of the exported classes overriding their virtual methods, a D implementation of the exported interface, and the
# finalization of the libraries' D objects. The program and the libraries use the shared D runtime.
.PHONY: run-test-roundtrip
run-test-roundtrip: export-gir
	rm -rf roundtrip/out && mkdir -p roundtrip/out/packages
	$(EXT_GIDGEN) --config roundtrip/gidgen.json --log-level=error
	$(DUB) add-local . 0.1.0 > /dev/null; status=0; \
	  (cd roundtrip/client && $(DUB) build -q --compiler=$(DC)) || status=$$?; \
	  $(DUB) remove-local . > /dev/null; exit $$status
	cd roundtrip/client && LD_LIBRARY_PATH="$$(pwd)/../../export-test:$$(pwd)/../../export-mixer:$$(pwd)/../../gidgen-test" \
	  G_DEBUG=fatal-criticals timeout 120 ./gidgen-roundtrip

.PHONY: run-test-export
run-test-export: packages/README.md $(FEAT_LIB)
	cd export-test && $(DUB) build -q --compiler=$(DC)
	gcc $(EXPORT_CFLAGS) -o export-test/export-test-linked export-test/export_test.c -Lexport-test -lgidgen-export \
	  $(EXPORT_LDFLAGS)
	gcc $(EXPORT_CFLAGS) -DUSE_DLOPEN -o export-test/export-test-dlopen export-test/export_test.c -ldl $(EXPORT_LDFLAGS)
	cd export-test && for t in linked dlopen; do LD_LIBRARY_PATH="$$(pwd):$$(pwd)/../gidgen-test" \
	  G_DEBUG=fatal-criticals timeout 120 ./export-test-$$t || exit 1; done

.PHONY: build-test
build-test: packages/README.md $(LIBS) $(MATRIX_MANIFEST)
	cd gidgen-test && { $(DUB) build -q --compiler=$(DC) --build=unittest > build.log 2>&1; status=$$?; \
	  cat build.log; exit $$status; }
	# GidSkip.Warn prints skipped members when the tests are compiled (checked when dub compiled them)
	! test -s gidgen-test/build.log || grep -q '^Warning: AutoClass.callback: not exported, unsupported property type' \
	  gidgen-test/build.log

# External dependency repository test: ext-child/ is a tiny child repository (a stub GIR including GObject) which
# depends on the packages, defs and GIRs of the gidgen test repository (above) through the dependencies config of
# ext-child/gidgen.json. Checks that only the child's package is written, the child's top-level dub.json only lists
# it, dependencies on the other repository use its umbrella name and the configured version, and that invalid
# configurations are rejected. The child package is then built against the generated test packages, which are
# temporarily registered as a local dub package.
EXT_GIDGEN = $(DUB) --root .. run -q --compiler=$(DC) --
EXT_OUT = ext-child/out

.PHONY: ext-test
ext-test: packages/README.md ext-child/gidgen.json ext-child/gir/ExtChild-1.0.gir $(wildcard ext-child/defs/*.d)
	rm -rf $(EXT_OUT) ext-child/out-bad ext-child/out-noshims ext-child/out-stale && mkdir -p $(EXT_OUT)/packages
	$(EXT_GIDGEN) --config ext-child/gidgen.json --log-level=error
	test "$$(ls $(EXT_OUT)/packages | grep -v '^README.md$$')" = extchild1
	grep -q '"gidg:glib2": "~>0.1.0"' $(EXT_OUT)/packages/extchild1/dub.json
	! grep -q '"gidg:glib2": "\*"\|"gidgext:' $(EXT_OUT)/packages/extchild1/dub.json
	grep -q '"name": "gidgext"' $(EXT_OUT)/dub.json
	grep -q '":extchild1": "\*"' $(EXT_OUT)/dub.json
	! grep -q 'glib2\|gobject2\|gidgenfeat' $(EXT_OUT)/dub.json $(EXT_OUT)/packages/README.md
	grep -q 'gidgext:extchild1' $(EXT_OUT)/packages/README.md
	grep -q 'Modules are named `gidgext.<package>.<module>`' $(EXT_OUT)/packages/README.md
	grep -q 'import gidgext.extchild1' $(EXT_OUT)/packages/README.md
	grep -q 'unversioned shims' $(EXT_OUT)/packages/README.md
	! grep -q 'import gid.gtk' $(EXT_OUT)/packages/README.md
	test -f $(EXT_OUT)/packages/extchild1/gidgext/extchild1/thing.d
	grep -q '^module gidgext.extchild1.thing;' $(EXT_OUT)/packages/extchild1/gidgext/extchild1/thing.d
	grep -q 'import gid.gobject2.object;' $(EXT_OUT)/packages/extchild1/gidgext/extchild1/thing.d
	grep -q '"sourcePaths": \["gidgext"\]' $(EXT_OUT)/packages/extchild1/dub.json
	test -f $(EXT_OUT)/packages/extchild1/gidgext/extchild/thing.d
	grep -q '^module gidgext.extchild.thing;' $(EXT_OUT)/packages/extchild1/gidgext/extchild/thing.d
	grep -q 'public import gidgext.extchild1.thing;' $(EXT_OUT)/packages/extchild1/gidgext/extchild/thing.d
	rm -rf ext-child/out-noshims && mkdir -p ext-child/out-noshims/packages
	$(EXT_GIDGEN) --config ext-child/gidgen-noshims.json --log-level=error
	test -f ext-child/out-noshims/packages/extchild1/gidgext/extchild1/thing.d
	! test -e ext-child/out-noshims/packages/extchild1/gidgext/extchild
	grep -q 'Modules are named `gidgext.<package>.<module>`' ext-child/out-noshims/packages/README.md
	! grep -q 'unversioned shims' ext-child/out-noshims/packages/README.md
	cp -a $(EXT_OUT) ext-child/out-stale
	test -f ext-child/out-stale/packages/extchild1/gidgext/extchild/thing.d
	echo 'module stale;' > ext-child/out-stale/packages/extchild1/gidgext/extchild/stale.d
	mkdir -p ext-child/out-stale/packages/extchild1/gidgext/keepme
	echo keep > ext-child/out-stale/packages/extchild1/gidgext/keepme/x.d
	$(EXT_GIDGEN) --config ext-child/gidgen-noshims.json --pkg-path ext-child/out-stale \
	  --subpkg-path ext-child/out-stale/packages --log-level=error
	test -f ext-child/out-stale/packages/extchild1/gidgext/extchild1/thing.d
	! test -e ext-child/out-stale/packages/extchild1/gidgext/extchild
	test -f ext-child/out-stale/packages/extchild1/gidgext/keepme/x.d
	! $(EXT_GIDGEN) --config ext-child/gidgen-noname.json --log-level=error > ext-child/noname.err 2>&1
	grep -q 'global //!info name is required' ext-child/noname.err
	! $(EXT_GIDGEN) --config ext-child/gidgen-dup.json --log-level=error > ext-child/dup.err 2>&1
	grep -q 'is defined by both' ext-child/dup.err
	! $(EXT_GIDGEN) --config ext-child/gidgen-badroot.json --log-level=error > ext-child/badroot.err 2>&1
	grep -q "can't be 'gid'" ext-child/badroot.err
	! $(EXT_GIDGEN) --config ext-child/gidgen-baddeproot.json --log-level=error > ext-child/baddeproot.err 2>&1
	grep -q "root of dependency 'gidg' must be 'gid'" ext-child/baddeproot.err
	test ! -e ext-child/out-bad
	$(DUB) add-local . 0.1.0 > /dev/null; status=0; \
	  (cd $(EXT_OUT)/packages/extchild1 && $(DUB) build -q --compiler=$(DC) --build=debug) || status=$$?; \
	  $(DUB) remove-local . > /dev/null; exit $$status

.PHONY: run-test-valgrind
run-test-valgrind: build-test
	cd gidgen-test && LD_LIBRARY_PATH="$$(pwd)" G_SLICE=always-malloc G_DEBUG=gc-friendly,fatal-criticals valgrind -q \
	  --error-exitcode=1 --leak-check=full --show-leak-kinds=definite --errors-for-leak-kinds=definite \
	  --suppressions=$(GLIB_SUPP) --suppressions=../valgrind.supp ./$(notdir $(TEST_BIN))

.PHONY: run-test-asan
run-test-asan:
	rm -f $(LIBS)
	$(MAKE) build-test EXTRA_CFLAGS="-fsanitize=address -fno-omit-frame-pointer" EXTRA_LDFLAGS="-fsanitize=address"
	cd gidgen-test && LD_LIBRARY_PATH="$$(pwd)" G_DEBUG=fatal-criticals LD_PRELOAD="$$(gcc -print-file-name=libasan.so)" \
	  ASAN_OPTIONS=detect_leaks=0 ./$(notdir $(TEST_BIN)); status=$$?; cd .. && rm -f $(LIBS); exit $$status

# Runtime definition files are symlinked from the main giD defs, global.d is adapted for the test package repository
defs/.stamp: $(addprefix $(GIDGEN_DEFS)/,$(RUNTIME_DEF_FILES) global.d)
	rm -rf defs && mkdir defs
	for f in $(RUNTIME_DEF_FILES); do ln -s ../$(GIDGEN_DEFS)/$$f defs/$$f; done
	sed -e 's|^//!info name .*|//!info name gidg|' -e 's|^//!info description .*|//!info description "Gidgen Test Repository"|' \
	  $(GIDGEN_DEFS)/global.d > defs/global.d
	touch $@

# ShimLib test library, built twice as two majors with the same symbol and GType names
gidgen-test/libshimlib-%.so.0: shimlib/shimlib.c
	gcc -shared -fPIC -Wl,-soname,$(notdir $@) -DSHIMLIB_MAJOR=$* $(TEST_CFLAGS) -o $@ $< $(TEST_LDFLAGS)

# GidgenFeat hand written test library
$(FEAT_LIB): gidgen-feat/gidgen-feat.c gidgen-feat/gidgen-feat.h
	gcc -shared -fPIC -Wl,-soname,$(notdir $@) $(TEST_CFLAGS) -o $@ $< $(TEST_LDFLAGS)
	ln -sf $(notdir $@) gidgen-test/libgidgen-feat.so

gir/GidgenFeat-1.0.gir: gidgen-feat/gidgen-feat.c gidgen-feat/gidgen-feat.h | $(FEAT_LIB)
	LD_LIBRARY_PATH="$$(pwd)/gidgen-test" g-ir-scanner --quiet --warn-all --warn-error \
	  --namespace=GidgenFeat --nsversion=1.0 --identifier-prefix=GidgenFeat --symbol-prefix=gidgen_feat \
	  --include=GObject-2.0 --pkg=gobject-2.0 -Lgidgen-test --library=gidgen-feat \
	  --c-include=gidgen-feat.h --output=$@ gidgen-feat/gidgen-feat.h gidgen-feat/gidgen-feat.c

# GidgenMatrix generator and generated test library
$(MATRIX_GEN): matrix-gen/dub.json matrix-gen/source/*.d
	cd matrix-gen && $(DUB) build -q --compiler=$(DC)

$(MATRIX_GEN_C) $(MATRIX_MANIFEST) $(MATRIX_DEFS) &: $(MATRIX_GEN)
	$(MATRIX_GEN) gidgen-matrix $(MATRIX_MANIFEST) $(MATRIX_DEFS)

$(MATRIX_LIB): $(MATRIX_SRC) $(MATRIX_HDR) gidgen-matrix/gidgen-matrix-private.h
	gcc -shared -fPIC -Wl,-soname,$(notdir $@) $(TEST_CFLAGS) -o $@ $(MATRIX_SRC) $(TEST_LDFLAGS)
	ln -sf $(notdir $@) gidgen-test/libgidgen-matrix.so

gir/GidgenMatrix-1.0.gir: $(MATRIX_SRC) $(MATRIX_HDR) | $(MATRIX_LIB)
	LD_LIBRARY_PATH="$$(pwd)/gidgen-test" g-ir-scanner --quiet --warn-all --warn-error \
	  --namespace=GidgenMatrix --nsversion=1.0 --identifier-prefix=GidgenMatrix --symbol-prefix=gidgen_matrix \
	  --include=GObject-2.0 --pkg=gobject-2.0 -Lgidgen-test --library=gidgen-matrix \
	  --c-include=gidgen-matrix-gen.h --output=$@ $(MATRIX_HDR) $(MATRIX_SRC)

# Generate the D binding packages
# (removed first so that modules of renamed types or functions do not linger, the dub build cache of the packages
# is removed too since dub keeps the objects of removed modules in its cached libraries)
packages/README.md: defs/.stamp test-defs/*.d $(MATRIX_DEFS) $(GIRS) $(wildcard gir/ShimLib-*.gir) $(GIDGEN_SOURCES)
	rm -rf packages "$${DUB_HOME:-$$HOME/.dub}/cache/gidg"
	$(DUB) --root .. run --compiler=$(DC) -- --defs defs --defs test-defs --gir-path gir --pkg-path . \
	  --subpkg-path packages --log-level=error

# gidgen coverage: gidgen is built directly with ldc2 -cov into a separate binary (the normal gidgen build is not
# touched) and run on the test definitions and GIRs, writing its packages to coverage/out. The JSON type info dump,
# binding report and definition suggestions are also generated (into coverage/out) to cover their code (the JSON
# dump exits after loading the repositories, so it is a separate run merged into the same coverage listings).
.PHONY: coverage
coverage: defs/.stamp $(MATRIX_DEFS) $(GIRS) $(COV_BIN)
	rm -rf coverage/lst coverage/out && mkdir -p coverage/lst coverage/out/packages && cp dub.json coverage/out/
	$(COV_BIN) --defs defs --defs test-defs --gir-path gir --pkg-path coverage/out --subpkg-path packages \
	  --log-level=error --report --report-file coverage/out/report.txt --suggest \
	  "--DRT-covopt=dstpath:coverage/lst merge:1" > coverage/out/suggest.txt
	$(COV_BIN) --defs defs --defs test-defs --gir-path gir --pkg-path coverage/out --subpkg-path packages \
	  --log-level=error --dump-json-docs \
	  "--DRT-covopt=dstpath:coverage/lst merge:1"
	mv gidgen-typeinfo.json coverage/out/
	@./coverage-summary.sh coverage/lst

$(COV_BIN): $(GIDGEN_SOURCES)
	mkdir -p coverage
	$(DC) -cov -g -I../source -od=coverage/obj -of=$@ $(GIDGEN_SOURCES)

.PHONY: clean
clean:
	-rm -f gidgen-test/libgidgen-*.so* $(SHIM_LIBS) $(TEST_BIN) gidgen-test/gidgen-loader-override export-test/libgidgen-export.so export-test/export-test-* export-test/gidgen-export-gir export-test/Gidgen*-1.0.gir export-mixer/libgidgen-mixer.so export-mixer/gidgen-mixer-gir roundtrip/client/gidgen-roundtrip $(GIRS) $(MATRIX_GEN) $(MATRIX_GEN_C) $(MATRIX_MANIFEST) $(MATRIX_DEFS)
	-rm -rf packages defs coverage matrix-gen/.dub export-test/.dub export-test/typelib export-mixer/.dub roundtrip/out roundtrip/client/.dub ext-child/out ext-child/out-bad ext-child/out-noshims ext-child/out-stale ext-child/*.err
