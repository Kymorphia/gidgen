# gidgen integration tests
#
# Test libraries are bound by gidgen and exercised with D unittests in gidgen-test/:
#   GidgenFeat - Hand written annotated C library in gidgen-feat/ with its GIR generated by g-ir-scanner, and hand
#                written D unittests in gidgen-test/feat_*.d (feature tests)
#   GidgenMatrix - Generated type/position matrix test library. matrix-gen/ crosses a type table with a position
#                table and generates C functions (gidgen-matrix/gidgen-matrix-gen.c/.h, built together with the hand
#                written gidgen-matrix/gidgen-matrix-support.c/.h) and a D manifest (gidgen-test/matrix_manifest.d)
#                which drives the generic D unittest gidgen-test/matrix_test.d, as well as the gidgen definitions
#                file test-defs/gidgenmatrix1.d
#
# GLib critical warnings are made fatal (G_DEBUG=fatal-criticals) so that they fail the tests.
#
# Targets:
#   run-test          Build and run the unittests
#   run-test-valgrind Run the unittests under valgrind memcheck (memory errors and definite leaks)
#   run-test-asan     Run the unittests with the C test libraries built with AddressSanitizer (memory errors)
#   coverage          Build gidgen with coverage instrumentation, run it on the test GIRs and print a per source file
#                     coverage summary (.lst files are written to coverage/)
#   clean             Remove generated files

DUB ?= dub
DC ?= ldc2
GIDGEN_DEFS = ../../defs
RUNTIME_DEF_FILES = $(notdir $(wildcard $(GIDGEN_DEFS)/gid*.d $(GIDGEN_DEFS)/glib2*.d $(GIDGEN_DEFS)/gobject2*.d \
  $(GIDGEN_DEFS)/gmodule2*.d))

TEST_CFLAGS = -g -Wall $(shell pkg-config --cflags gobject-2.0) $(EXTRA_CFLAGS)
TEST_LDFLAGS = $(shell pkg-config --libs gobject-2.0) $(EXTRA_LDFLAGS)

TEST_BIN = gidgen-test/gidgen-test
FEAT_LIB = gidgen-test/libgidgen-feat.so.0
MATRIX_LIB = gidgen-test/libgidgen-matrix.so.0
LIBS = $(FEAT_LIB) $(MATRIX_LIB)
GIRS = gir/GidgenFeat-1.0.gir gir/GidgenMatrix-1.0.gir

MATRIX_GEN = matrix-gen/matrix-gen
MATRIX_GEN_C = gidgen-matrix/gidgen-matrix-gen.c gidgen-matrix/gidgen-matrix-gen.h
MATRIX_MANIFEST = gidgen-test/matrix_manifest.d
MATRIX_DEFS = test-defs/gidgenmatrix1.d
MATRIX_SRC = gidgen-matrix/gidgen-matrix-support.c gidgen-matrix/gidgen-matrix-gen.c
MATRIX_HDR = gidgen-matrix/gidgen-matrix-support.h gidgen-matrix/gidgen-matrix-gen.h

GIDGEN_SOURCES = $(wildcard ../source/*.d ../source/*/*.d)
COV_BIN = coverage/gidgen-cov
GLIB_SUPP = $(shell pkg-config --variable=prefix glib-2.0)/share/glib-2.0/valgrind/glib.supp

.PHONY: run-test
run-test: build-test
	cd gidgen-test && LD_LIBRARY_PATH="$$(pwd)" G_DEBUG=fatal-criticals ./$(notdir $(TEST_BIN))

.PHONY: build-test
build-test: packages/README.md $(LIBS) $(MATRIX_MANIFEST)
	cd gidgen-test && $(DUB) build -q --compiler=$(DC) --build=unittest

.PHONY: run-test-valgrind
run-test-valgrind: build-test
	cd gidgen-test && LD_LIBRARY_PATH="$$(pwd)" G_SLICE=always-malloc G_DEBUG=gc-friendly,fatal-criticals valgrind -q \
	  --error-exitcode=1 --leak-check=full --show-leak-kinds=definite --errors-for-leak-kinds=definite \
	  --suppressions=$(GLIB_SUPP) --suppressions=../valgrind.supp ./$(notdir $(TEST_BIN))

.PHONY: run-test-asan
run-test-asan:
	rm -f $(LIBS)
	$(MAKE) build-test EXTRA_CFLAGS="-fsanitize=address -fno-omit-frame-pointer" EXTRA_LDFLAGS="-fsanitize=address"
	cd gidgen-test && LD_LIBRARY_PATH="$$(pwd)" G_DEBUG=fatal-criticals LD_PRELOAD="$$(gcc -print-file-name=libasan.so)" \
	  ASAN_OPTIONS=detect_leaks=0 ./$(notdir $(TEST_BIN)); status=$$?; cd .. && rm -f $(LIBS); exit $$status

# Runtime definition files are symlinked from the main giD defs, global.d is adapted for the test package repository
defs/.stamp: $(addprefix $(GIDGEN_DEFS)/,$(RUNTIME_DEF_FILES) global.d)
	rm -rf defs && mkdir defs
	for f in $(RUNTIME_DEF_FILES); do ln -s ../$(GIDGEN_DEFS)/$$f defs/$$f; done
	sed -e 's|^//!info name .*|//!info name gidg|' -e 's|^//!info description .*|//!info description "Gidgen Test Repository"|' \
	  $(GIDGEN_DEFS)/global.d > defs/global.d
	touch $@

# GidgenFeat hand written test library
$(FEAT_LIB): gidgen-feat/gidgen-feat.c gidgen-feat/gidgen-feat.h
	gcc -shared -fPIC -Wl,-soname,$(notdir $@) $(TEST_CFLAGS) -o $@ $< $(TEST_LDFLAGS)
	ln -sf $(notdir $@) gidgen-test/libgidgen-feat.so

gir/GidgenFeat-1.0.gir: gidgen-feat/gidgen-feat.c gidgen-feat/gidgen-feat.h | $(FEAT_LIB)
	LD_LIBRARY_PATH="$$(pwd)/gidgen-test" g-ir-scanner --quiet --warn-all --warn-error \
	  --namespace=GidgenFeat --nsversion=1.0 --identifier-prefix=GidgenFeat --symbol-prefix=gidgen_feat \
	  --include=GObject-2.0 --pkg=gobject-2.0 -Lgidgen-test --library=gidgen-feat \
	  --c-include=gidgen-feat.h --output=$@ gidgen-feat/gidgen-feat.h gidgen-feat/gidgen-feat.c

# GidgenMatrix generator and generated test library
$(MATRIX_GEN): matrix-gen/dub.json matrix-gen/source/*.d
	cd matrix-gen && $(DUB) build -q --compiler=$(DC)

$(MATRIX_GEN_C) $(MATRIX_MANIFEST) $(MATRIX_DEFS) &: $(MATRIX_GEN)
	$(MATRIX_GEN) gidgen-matrix $(MATRIX_MANIFEST) $(MATRIX_DEFS)

$(MATRIX_LIB): $(MATRIX_SRC) $(MATRIX_HDR) gidgen-matrix/gidgen-matrix-private.h
	gcc -shared -fPIC -Wl,-soname,$(notdir $@) $(TEST_CFLAGS) -o $@ $(MATRIX_SRC) $(TEST_LDFLAGS)
	ln -sf $(notdir $@) gidgen-test/libgidgen-matrix.so

gir/GidgenMatrix-1.0.gir: $(MATRIX_SRC) $(MATRIX_HDR) | $(MATRIX_LIB)
	LD_LIBRARY_PATH="$$(pwd)/gidgen-test" g-ir-scanner --quiet --warn-all --warn-error \
	  --namespace=GidgenMatrix --nsversion=1.0 --identifier-prefix=GidgenMatrix --symbol-prefix=gidgen_matrix \
	  --include=GObject-2.0 --pkg=gobject-2.0 -Lgidgen-test --library=gidgen-matrix \
	  --c-include=gidgen-matrix-gen.h --output=$@ $(MATRIX_HDR) $(MATRIX_SRC)

# Generate the D binding packages
# (removed first so that modules of renamed types or functions do not linger, the dub build cache of the packages
# is removed too since dub keeps the objects of removed modules in its cached libraries)
packages/README.md: defs/.stamp test-defs/*.d $(MATRIX_DEFS) $(GIRS) $(GIDGEN_SOURCES)
	rm -rf packages "$${DUB_HOME:-$$HOME/.dub}/cache/gidg"
	$(DUB) --root .. run --compiler=$(DC) gidgen -- --defs defs --defs test-defs --gir-path gir --pkg-path . \
	  --subpkg-path packages --log-level=error

# gidgen coverage: gidgen is built directly with ldc2 -cov into a separate binary (the normal gidgen build is not
# touched) and run on the test definitions and GIRs, writing its packages to coverage/out. The JSON type info dump,
# binding report and definition suggestions are also generated (into coverage/out) to cover their code (the JSON
# dump exits after loading the repositories, so it is a separate run merged into the same coverage listings).
.PHONY: coverage
coverage: defs/.stamp $(MATRIX_DEFS) $(GIRS) $(COV_BIN)
	rm -rf coverage/lst coverage/out && mkdir -p coverage/lst coverage/out/packages && cp dub.json coverage/out/
	$(COV_BIN) --defs defs --defs test-defs --gir-path gir --pkg-path coverage/out --subpkg-path packages \
	  --log-level=error --report --report-file coverage/out/report.txt --suggest \
	  "--DRT-covopt=dstpath:coverage/lst merge:1" > coverage/out/suggest.txt
	$(COV_BIN) --defs defs --defs test-defs --gir-path gir --pkg-path coverage/out --subpkg-path packages \
	  --log-level=error --dump-json-docs \
	  "--DRT-covopt=dstpath:coverage/lst merge:1"
	mv gidgen-typeinfo.json coverage/out/
	@./coverage-summary.sh coverage/lst

$(COV_BIN): $(GIDGEN_SOURCES)
	mkdir -p coverage
	$(DC) -cov -g -I../source -od=coverage/obj -of=$@ $(GIDGEN_SOURCES)

.PHONY: clean
clean:
	-rm -f gidgen-test/libgidgen-*.so* $(TEST_BIN) $(GIRS) $(MATRIX_GEN) $(MATRIX_GEN_C) $(MATRIX_MANIFEST) $(MATRIX_DEFS)
	-rm -rf packages defs coverage matrix-gen/.dub
