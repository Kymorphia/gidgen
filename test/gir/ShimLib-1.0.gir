<?xml version="1.0"?>
<!-- Hand written stub GIR (no C library), for unversioned shim module tests -->
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <include name="GObject" version="2.0"/>
  <package name="gobject-2.0"/>
  <c:include name="shimlib.h"/>
  <namespace name="ShimLib"
             version="1.0"
             shared-library="libshimlib-1.so.0"
             c:identifier-prefixes="ShimLib"
             c:symbol-prefixes="shim_lib">
    <class name="Widget"
           c:symbol-prefix="widget"
           c:type="ShimLib1Widget"
           parent="GObject.Object"
           glib:type-name="ShimLib1Widget"
           glib:get-type="shim_lib1_widget_get_type"
           glib:type-struct="WidgetClass">
    </class>
    <record name="WidgetClass"
            c:type="ShimLib1WidgetClass"
            glib:is-gtype-struct-for="Widget">
      <field name="parent_class">
        <type name="GObject.ObjectClass" c:type="GObjectClass"/>
      </field>
    </record>
  </namespace>
</repository>
