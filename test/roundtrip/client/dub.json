{
  "name": "gidgen-roundtrip",
  "description": "D client of the GObjectExport test libraries through the bindings gidgen generated from their GIRs",
  "copyright": "Copyright \u00a9 2026, Kymorphia, PBC",
  "authors": [
    "Element Green <element@kymorphia.com>"
  ],
